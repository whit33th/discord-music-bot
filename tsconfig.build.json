{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true
  },
  "include": [
    "*.ts",
    "commands/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
